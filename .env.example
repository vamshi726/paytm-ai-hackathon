# Saathi uses a local SQLite database by default.
DATABASE_URL=sqlite:///./saathi.db
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
HITL_EMAIL=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
# Optional overrides; otherwise the IMAP reader uses SMTP_USERNAME / SMTP_PASSWORD.
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated approvers; each receives a notification for a new request.
HITL_APPROVER_EMAILS=approver-one@example.com,approver-two@example.com
# Kept for compatibility when only one reviewer is needed.
HITL_APPROVER_EMAIL=
SMTP_USE_TLS=true
